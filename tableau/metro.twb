      <column caption='On-time %' datatype='real' default-format='p0.00%' name='[Calculation_2552029183369225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([on_time]) / SUM([trusted])' />
      </column>
      <column caption='Trusted share' datatype='real' default-format='p0.00%' name='[Calculation_2552029183430666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([trusted]) / SUM([visits])' />
      </column>
      <column caption='Early %' datatype='real' default-format='p0.00%' name='[Calculation_2552029183512587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([early]) / SUM([trusted])' />
