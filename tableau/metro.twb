      <aliases enabled='yes' />
      <column caption='On-time %' datatype='real' default-format='p0.00%' name='[Calculation_2468741113233408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([on_time])/SUM([trusted])' />
      </column>
      <column caption='Trusted share' datatype='real' default-format='p0.00%' name='[Calculation_2468741113704449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([trusted])/SUM([visits])' />
      </column>
      <column caption='Route' datatype='string' name='[Calculation_2552029155299332]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[route_id (routes.csv)] + &quot; &quot; + [long_name]' />
      </column>
      <column caption='Early %' datatype='real' default-format='p0.00%' name='[Calculation_2552029158813701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([early])/ SUM([trusted])' />
      </column>
      <column caption='Late %' datatype='real' default-format='p0.00%' name='[Calculation_2552029158948870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([late])/SUM([trusted])' />
      </column>
      <column caption='Service type' datatype='string' name='[Calculation_2552029162516487]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE LEFT([route_id (routes.csv)], 1)&#13;&#10;WHEN &quot;0&quot; THEN &quot;Local&quot;&#13;&#10;WHEN &quot;1&quot; THEN &quot;Express&quot;&#13;&#10;WHEN &quot;2&quot; THEN &quot;Park &amp; Ride&quot;&#13;&#10;WHEN &quot;3&quot; THEN &quot;Community&quot;&#13;&#10;WHEN &quot;4&quot; THEN &quot;Bus rapid transit&quot;&#13;&#10;WHEN &quot;5&quot; THEN &quot;Direct&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Hour label' datatype='string' name='[Calculation_2552029168205832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(IIF([hour] % 12 = 0, 12, [hour] % 12)) + IIF([hour] % 24 &lt; 12, &quot;a&quot;, &quot;p&quot;)' />
      </column>
